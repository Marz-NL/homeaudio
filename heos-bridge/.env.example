# Copy to .env next to docker-compose.yml. .env is git-ignored: it holds a token.
TZ=Europe/Amsterdam

# The HEOS speaker (see the HEOS app, or your router's DHCP list)
HEOS_IP=192.168.1.60

# Music Assistant, to show what it plays on the speaker. Token: Music Assistant
# settings -> Profile -> Long-lived access tokens. Leave the token empty to skip.
MASS_API_URL=http://192.168.1.10:8095
MASS_API_TOKEN=

# Optional: push "now playing" to a Home Assistant webhook (see pi/install/add-now-playing.sh)
HA_WEBHOOK_URL=
