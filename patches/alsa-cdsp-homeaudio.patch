# homeaudio patch for alsa_cdsp (github.com/scripple/alsa_cdsp, commit 1a1b0a3):
# when an application sets hw_params again without hw_free in between (PortAudio
# restarting a stream on a seek), stop the CamillaDSP started for the previous
# hw_params first - otherwise it keeps its pipe open and the DAC busy.

diff --git a/libasound_module_pcm_cdsp.c b/libasound_module_pcm_cdsp.c
index a9fa6d4..337c645 100644
--- a/libasound_module_pcm_cdsp.c
+++ b/libasound_module_pcm_cdsp.c
@@ -786,6 +786,17 @@ static int cdsp_hw_params(snd_pcm_ioplug_t *io, snd_pcm_hw_params_t *params __at
 
   pcm->frame_size = (snd_pcm_format_physical_width(io->format)*io->channels)/8;
 
+  // An application may set hw_params again without hw_free in between (e.g.
+  // PortAudio when a stream is restarted, on a seek). Stop the CamillaDSP
+  // started last time first: otherwise it keeps its pipe and the DAC, and the
+  // new one finds the DAC busy.
+  if (pcm->cpid != -1) {
+    debug("hw_params again: stopping the previous CamillaDSP\n");
+    close_transport(pcm);
+    waitpid(pcm->cpid, NULL, 0);
+    pcm->cpid = -1;
+  }
+
   // Start CamillaDSP in a forked process
   start_camilla(pcm);
 
