# spotifyd v0.4.2: linear software volume instead of the hard-coded 60 dB log curve
# (75% = -2.5 dB instead of -15 dB), matching pibuz. Used for the prebuilt
# binary in this project's releases and for BUILD=1 in lib/sources/spotify.sh.
--- a/src/setup.rs	2026-09-30 14:30:21.921886362 +0200
+++ b/src/setup.rs	2026-09-30 14:30:21.949345209 +0200
@@ -64,7 +64,7 @@
             }
             _ => {
                 info!("Using software volume controller.");
-                let mixer = mixer::softmixer::SoftMixer::open(MixerConfig::default())
+                let mixer = mixer::softmixer::SoftMixer::open(MixerConfig { volume_ctrl: librespot_playback::config::VolumeCtrl::Linear, ..MixerConfig::default() })
                     .expect("SoftMixer::open never returns an Error");
                 Arc::new(mixer)
             }
