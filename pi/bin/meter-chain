#!/bin/sh
# homeaudio: CamillaDSP between the sources and the DAC, which also gives the
# meters their levels. Sources play into the loopback card; this follows that
# stream and runs CamillaDSP on the card's other end (hw:Loopback,1,0), feeding
# the DAC. It owns CamillaDSP's config: the output rate (/etc/homeaudio/output-rate:
# native, or a rate the DAC lists) is applied live with a SIGHUP reload, so the
# music doesn't stop. CamillaDSP runs only while something plays, so the DAC is
# free the rest of the time.
set -u
LB=/proc/asound/card$(awk '/\[Loopback/ {print $1}' /proc/asound/cards)   # snd-aloop, found by name (/etc/modules-load.d)
RUN=/run/homeaudio-cdsp
TARGET=/etc/homeaudio/output-rate
PORT=5678
DAC=$(sed -n 's/^USB_CARD=//p' /etc/homeaudio/cdsp-dac)
mkdir -p "$RUN"
src_key=""; tgt=""; pid=""

stop_cdsp() {
  [ -n "$pid" ] && kill "$pid" 2>/dev/null && wait "$pid" 2>/dev/null
  pid=""; src_key=""
}

# $1 ALSA format, $2 source rate, $3 channels, $4 target: native or a rate
write_config() {
  case "$1" in
    S24_3LE) fmt=S24_3_LE ;; S24_LE) fmt=S24_4_LE ;;
    FLOAT_LE) fmt=F32_LE ;; FLOAT64_LE) fmt=F64_LE ;; *) fmt=$1 ;;
  esac
  if [ "$4" = native ] || [ "$4" = "$2" ]; then
    out=$2; convert=
  else
    out=$4; convert=1      # converted; 1 dB headroom, as resampling can overshoot
  fi
  {
    cat <<CFG
devices:
  samplerate: $out
  chunksize: 1024
  capture_samplerate: $2
CFG
    if [ -n "$convert" ]; then cat <<CFG
  resampler:
    type: Synchronous
CFG
    fi
    cat <<CFG
  capture:
    type: Alsa
    channels: $3
    device: "hw:Loopback,1,$SUB"
    format: $fmt
  playback:
    type: Alsa
    channels: $3
    device: "hw:CARD=$DAC,DEV=0"
CFG
    if [ -n "$convert" ]; then cat <<CFG
filters:
  headroom:
    type: Gain
    parameters:
      gain: -1.0
pipeline:
  - type: Filter
    channels: [0, 1]
    names: [headroom]
CFG
    fi
  } > "$RUN/config.yml.new"
  mv -f "$RUN/config.yml.new" "$RUN/config.yml"
}

start_cdsp() {   # $1 format, $2 rate, $3 channels, $4 target
  write_config "$1" "$2" "$3" "$4"
  camilladsp -o "$RUN/camilladsp.log" -p "$PORT" -a 127.0.0.1 "$RUN/config.yml" &
  pid=$!
}

# The loopback subdevice of the source that owns the DAC: qobuz 0, spotify 1,
# airplay 2, Music Assistant 3 (the guard writes the owner). Failing that, the first
# subdevice that is open.
active_sub() {
  local owner n
  owner=$(cat /run/player-guard/audio-owner 2>/dev/null)
  case "$owner" in qobuz) n=0 ;; spotify) n=1 ;; airplay) n=2 ;; ma) n=3 ;; *) n= ;; esac
  if [ -n "$n" ] && grep -q '^rate:' "$LB/pcm0p/sub$n/hw_params" 2>/dev/null; then echo "$n"; return; fi
  for n in 0 1 2 3 4 5 6 7; do
    grep -q '^rate:' "$LB/pcm0p/sub$n/hw_params" 2>/dev/null && { echo "$n"; return; }
  done
}

while :; do
  SUB=$(active_sub)
  hw=$LB/pcm0p/sub${SUB:-0}/hw_params
  if [ -r "$hw" ] && grep -q '^rate:' "$hw"; then
    fmt=$(sed -n 's/^format: //p' "$hw")
    rate=$(sed -n 's/^rate: \([0-9]*\).*/\1/p' "$hw")
    ch=$(sed -n 's/^channels: //p' "$hw")
    tgt=$(cat "$TARGET" 2>/dev/null || echo native)
    key="$fmt $rate $ch $SUB"
    # CamillaDSP died while a stream plays: start it again
    if [ -n "$pid" ] && ! kill -0 "$pid" 2>/dev/null; then pid=""; src_key=""; fi
    if [ "$key" != "$src_key" ]; then
      stop_cdsp
      start_cdsp "$fmt" "$rate" "$ch" "$tgt"
      src_key=$key; cur_tgt=$tgt
    elif [ "$tgt" != "$cur_tgt" ] && [ -n "$pid" ]; then
      write_config "$fmt" "$rate" "$ch" "$tgt"   # live: CamillaDSP re-reads its config
      kill -HUP "$pid" 2>/dev/null
      cur_tgt=$tgt
    fi
  else
    stop_cdsp
  fi
  sleep 0.2
done
